{
  "version": 5,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "MCPRICER_WARNINGS_AS_ERRORS": "ON" }
    },
    {
      "name": "msvc",
      "displayName": "MSVC (Visual Studio 2026)",
      "inherits": "base",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64"
    },
    {
      "name": "gcc",
      "displayName": "GCC (MinGW, Release)",
      "inherits": "base",
      "generator": "MinGW Makefiles",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "g++", "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "msvc-release", "configurePreset": "msvc", "configuration": "Release" },
    { "name": "msvc-debug", "configurePreset": "msvc", "configuration": "Debug" },
    { "name": "gcc-release", "configurePreset": "gcc" }
  ],
  "testPresets": [
    {
      "name": "msvc-release",
      "configurePreset": "msvc",
      "configuration": "Release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "msvc-debug",
      "configurePreset": "msvc",
      "configuration": "Debug",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "gcc-release",
      "configurePreset": "gcc",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ]
}
